# Normalize line endings to LF in the repository and in working copies.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.ico binary
*.icns binary
*.webp binary
*.gif binary
*.mp4 binary
*.woff2 binary
docs/screenshots/** binary

# Lockfiles: keep diffs out of reviews
package-lock.json -diff
src-tauri/Cargo.lock -diff
