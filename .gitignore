# ---------------------------------------------------------------------------
# IGrasp - Tauri v2 (Rust) + React + TypeScript + Vite
# Note: Cargo.lock and package-lock.json / pnpm-lock.yaml are committed (this is an app).
# ---------------------------------------------------------------------------

.local/

# --- Node / frontend ---
node_modules/
dist/
dist-ssr/
build/
.vite/
*.tsbuildinfo
.eslintcache
.stylelintcache
coverage/
*.lcov
.nyc_output/

# Package manager logs and caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# --- Rust / Tauri ---
target/
src-tauri/target/
src-tauri/gen/schemas/
# Rust backup files from rustfmt
**/*.rs.bk
*.pdb

# --- Tests (Playwright / Vitest / WebDriver) ---
test-results/
playwright-report/
blob-report/
playwright/.cache/

# --- Environment and secrets ---
.env
.env.*
!.env.example
# Tauri updater / code-signing keys
*.key
*.pem
*.pfx
*.p12

# --- Logs and temp files ---
logs/
*.log
*.tmp
*.temp
.cache/

# --- Quiz results saved by the app (default location) ---
quiz-results/

# --- Editors / IDEs ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# --- Claude Code local settings ---
.claude/settings.local.json

# --- OS files ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.directory
